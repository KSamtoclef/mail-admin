ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy Supabase keys are also supported as fallback:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

EMAIL_PROVIDER=resend
DEFAULT_FROM_EMAIL=
DEFAULT_FROM_NAME=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Cookies Pilot / Cloud365 integration.
# The supplied package documents the generated CURL endpoint but does not define an auth header contract,
# so Mail Admin calls the endpoint server-side as a GET and keeps these credentials private for future vendor auth support.
COOKIE_PILOT_ENABLED=false
COOKIE_PILOT_ENDPOINT=
COOKIE_PILOT_CONNECT_ID=
COOKIE_PILOT_API_KEY=
COOKIE_PILOT_EMAIL=

# Optional: used only if you later enable an external scheduler for /api/cron/dispatch.
CRON_SECRET=

# TRACKING_BASE_URL normally auto-resolves from the Vercel production URL.
# Set it explicitly only when using a custom tracking domain.
TRACKING_BASE_URL=

# Optional legacy/static origin allow-list. Tracking Sites in Supabase is the preferred control.
TRACKING_ALLOWED_ORIGINS=
